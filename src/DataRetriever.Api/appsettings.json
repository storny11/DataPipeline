{
  "Application": {
    "Name": "DataRetriever"
  },
  "AdapterMode": "Simulator",
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning"
      }
    }
  },
  "feature_management": {
    "feature_flags": [
      {
        "id": "DataRetrievalRuns",
        "enabled": true
      }
    ]
  },
  "EmailReport": {
    "Enabled": true,
    "Host": "localhost",
    "Port": 2525,
    "From": "dataretriever@test.local",
    "ServiceName": "Data retrieval",
    "To": "elena@test.local",
    "CompactTo": "elena@test.local"
  },
  "AllowedHosts": "*"
}
