{
  "Application": {
    "Name": "DataRetriever"
  },
  "AdapterMode": "Simulator",
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console",
      "Serilog.Sinks.File"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning"
      }
    },
    "Enrich": [
      "FromLogContext"
    ],
    "WriteTo": {
      "ConsoleSink": {
        "Name": "Console"
      },
      "FileSink": {
        "Name": "File",
        "Args": {
          "path": "logs/DataRetriever-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 14,
          "fileSizeLimitBytes": 10485760,
          "rollOnFileSizeLimit": true,
          "shared": true
        }
      }
    }
  },
  "feature_management": {
    "feature_flags": [
      {
        "id": "DataRetrievalRuns",
        "enabled": true
      }
    ]
  },
  "EmailReport": {
    "Enabled": true,
    "Host": "localhost",
    "Port": 2525,
    "From": "dataretriever@test.local",
    "ServiceName": "Data retrieval",
    "To": "elena@test.local",
    "CompactTo": "elena@test.local"
  },
  "AllowedHosts": "*"
}
