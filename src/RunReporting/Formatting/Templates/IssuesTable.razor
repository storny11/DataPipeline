@* Renders warning or error issues as an email-safe table. *@
@using Microsoft.AspNetCore.Components
@namespace RunReporting.Templates

@if (Issues.Count == 0)
{
    <table width="100%" cellspacing="0" cellpadding="0" border="0" style="@EmptyStateTableStyle">
        <tbody>
            <tr>
                <td bgcolor="#f8fafc" style="@EmptyStateCellStyle">None.</td>
            </tr>
        </tbody>
    </table>
}
else
{
    <table width="100%" cellspacing="0" cellpadding="0" border="0" style="@GridStyle">
        <thead>
            <tr>
                <th align="left" bgcolor="@HeaderBackground" style="@HeaderCellStyleFor()">STEP</th>
                <th align="left" bgcolor="@HeaderBackground" style="@HeaderCellStyleFor()">KEY</th>
                <th align="left" bgcolor="@HeaderBackground" style="@HeaderCellStyleFor()">DETAILS</th>
                <th align="left" bgcolor="@HeaderBackground" style="@HeaderCellStyleFor()">MESSAGE</th>
            </tr>
        </thead>
        <tbody>
            @for (var index = 0; index < Issues.Count; index++)
            {
                var issue = Issues[index];
                var rowBackground = RowBackground(index);
                <tr>
                    <td bgcolor="@rowBackground" style="@CellStyleFor(rowBackground)">@StepName(issue)</td>
                    <td bgcolor="@rowBackground" style="@MonoCellStyleFor(rowBackground)">@IssueKey(issue)</td>
                    <td bgcolor="@rowBackground" style="@MonoCellStyleFor(rowBackground)">@FormatData(issue)</td>
                    <td bgcolor="@rowBackground" style="@CellStyleFor(rowBackground)">@issue.Message</td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    [Parameter]
    public IReadOnlyList<RunIssue> Issues { get; set; } = [];

    /// <summary>Header row fill. Callers choose blue data headers or subtle issue tints.</summary>
    [Parameter]
    public string HeaderBackground { get; set; } = "#2557a7";

    [Parameter]
    public string HeaderForeground { get; set; } = "#ffffff";

    private const string GridStyle = "border-collapse:collapse; width:100%; background-color:#ffffff; border:1px solid #e6ebf2; mso-table-lspace:0pt; mso-table-rspace:0pt;";
    private const string HeaderCellBaseStyle = "border:1px solid #e6ebf2; padding:8px 12px; font-size:12px; line-height:16px; font-weight:700; letter-spacing:0.3px; mso-line-height-rule:exactly;";
    private const string CellStyle = "border:1px solid #edf1f6; padding:9px 12px; font-size:14px; line-height:20px; color:#344054; vertical-align:top; mso-line-height-rule:exactly;";
    private const string MonoCellStyle = CellStyle + " font-family:Consolas, 'Courier New', monospace;";
    private const string EmptyStateTableStyle = "width:100%; border-collapse:collapse; border:1px solid #d7dde8; mso-table-lspace:0pt; mso-table-rspace:0pt;";
    private const string EmptyStateCellStyle = "padding:12px 14px; background-color:#f8fafc; color:#475467; font-size:13px; line-height:19px; mso-line-height-rule:exactly;";

    private static string RowBackground(int index) => index % 2 == 0 ? "#ffffff" : "#fbfcfe";

    private static string StepName(RunIssue issue) =>
        string.IsNullOrWhiteSpace(issue.StepName) ? "-" : issue.StepName;

    private static string IssueKey(RunIssue issue) =>
        string.IsNullOrWhiteSpace(issue.Key) ? "-" : issue.Key;

    private static string FormatData(RunIssue issue)
    {
        return issue.Data.Count == 0
            ? "-"
            : string.Join(", ", issue.Data.Select(pair => $"{pair.Key}={pair.Value}"));
    }

    private string HeaderCellStyleFor() => $"{HeaderCellBaseStyle} background-color:{HeaderBackground}; color:{HeaderForeground};";

    private static string CellStyleFor(string backgroundColor) => $"{CellStyle} background-color:{backgroundColor};";

    private static string MonoCellStyleFor(string backgroundColor) => $"{MonoCellStyle} background-color:{backgroundColor};";
}
