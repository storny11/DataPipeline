@* Default email layout: run outcome, errors, warnings, and result tables. *@
@using System.Globalization
@using Microsoft.AspNetCore.Components
@namespace RunReporting.Templates

@{
    var summaryItems = Report.Attributes
        .Select(attribute => (
            Label: ValueFormatter.ToHeader(attribute.Key),
            Value: attribute.Value,
            IsCopyFriendly: IsRunIdAttribute(attribute.Key)))
        .ToList();
    var warnings = Report.Issues.Where(issue => issue.Severity == IssueSeverity.Warning).ToList();
    var errors = Report.Issues.Where(issue => issue.Severity == IssueSeverity.Error).ToList();
}

<!DOCTYPE html>
<html>
<head>
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
</head>
<body style="@BodyStyle" bgcolor="#f5f7fb">
    @* Hidden preheader: inbox preview shows the outcome instead of layout markup. *@
    <div style="@PreheaderStyle">@StatusHeading — @Report.ErrorCount errors, @Report.WarningCount warnings</div>
    <table width="100%" cellspacing="0" cellpadding="0" border="0" bgcolor="#f5f7fb" style="@OuterTableStyle">
        <tbody>
            <tr>
                <td align="center" style="@OuterCellStyle">
                    <table width="1180" align="center" cellspacing="0" cellpadding="0" border="0" style="@ContainerTableStyle">
                        <tbody>
                            <tr>
                                <td>
                                    <table width="100%" cellspacing="0" cellpadding="0" border="0" bgcolor="#ffffff" style="@PanelTableStyle">
                                        <tbody>
                                            <tr>
                                                <td height="3" bgcolor="@AccentColor" style="@HeaderAccentStyle">&nbsp;</td>
                                            </tr>
                                            <tr>
                                                <td bgcolor="#182b49" style="@HeaderContentStyle">
                                                    <div style="@EyebrowStyle">RUN REPORT</div>
                                                    <div style="@TitleStyle">@StatusHeading</div>
                                                    <table cellspacing="0" cellpadding="0" border="0" style="@StatusTableStyle">
                                                        <tbody>
                                                            <tr>
                                                                <td bgcolor="@StatusBackground" style="@StatusPillStyle">@OutcomeText</td>
                                                            </tr>
                                                        </tbody>
                                                    </table>
                                                </td>
                                            </tr>
                                        </tbody>
                                    </table>
                                </td>
                            </tr>

                            @if (summaryItems.Count > 0)
                            {
                                <tr><td height="16" style="@SpacerStyle">&nbsp;</td></tr>

                                <tr>
                                    <td>
                                        <table width="100%" cellspacing="0" cellpadding="0" border="0" bgcolor="#f5f7fb" style="@SummaryTableStyle">
                                            <tbody>
                                                @for (var index = 0; index < summaryItems.Count; index += 4)
                                                {
                                                    <tr>
                                                        @for (var offset = 0; offset < 4; offset++)
                                                        {
                                                            var itemIndex = index + offset;
                                                            <td width="25%" valign="top" style="@SummaryCellStyle">
                                                                @if (itemIndex < summaryItems.Count)
                                                                {
                                                                    <table width="100%" cellspacing="0" cellpadding="0" border="0" bgcolor="#fbfcfe" style="@SummaryCardStyle">
                                                                        <tbody>
                                                                            <tr>
                                                                                <td style="@SummaryCardCellStyle">
                                                                                    <div style="@SummaryLabelStyle">@summaryItems[itemIndex].Label</div>
                                                                                    <div style="@SummaryValueStyleFor(summaryItems[itemIndex].IsCopyFriendly)">@(summaryItems[itemIndex].Value ?? "-")</div>
                                                                                </td>
                                                                            </tr>
                                                                        </tbody>
                                                                    </table>
                                                                }
                                                                else
                                                                {
                                                                    @: &nbsp;
                                                                }
                                                            </td>
                                                        }
                                                    </tr>
                                                }
                                            </tbody>
                                        </table>
                                    </td>
                                </tr>
                            }

                            @if (Report.Issues.Count == 0)
                            {
                                <tr><td height="18" style="@SpacerStyle">&nbsp;</td></tr>
                                <tr>
                                    <td>
                                        <table width="100%" cellspacing="0" cellpadding="0" border="0" bgcolor="#ffffff" style="@PanelTableStyle">
                                            <tbody>
                                                <tr>
                                                    <td bgcolor="#ffffff" style="@AllClearContentStyle">
                                                        <div style="@AllClearHeadingStyle">All clear</div>
                                                        <div style="@AllClearCaptionStyle">No issues were reported during this run.</div>
                                                    </td>
                                                </tr>
                                            </tbody>
                                        </table>
                                    </td>
                                </tr>
                            }

                            @if (errors.Count > 0)
                            {
                                <tr><td height="18" style="@SpacerStyle">&nbsp;</td></tr>
                                <tr>
                                    <td>
                                        <table width="100%" cellspacing="0" cellpadding="0" border="0" bgcolor="#ffffff" style="@PanelTableStyle">
                                            <tbody>
                                                <tr>
                                                    <td style="@ErrorsSectionContentStyle">
                                                        <div style="@ErrorsHeadingStyle">Errors (@errors.Count)</div>
                                                        <div style="@SectionCaptionStyle">These items need attention before the run can be treated as clean.</div>
                                                        <IssuesTable Issues="errors" HeaderBackground="#fef3f2" HeaderForeground="#b42318" />
                                                    </td>
                                                </tr>
                                            </tbody>
                                        </table>
                                    </td>
                                </tr>
                            }

                            @if (warnings.Count > 0)
                            {
                                <tr><td height="18" style="@SpacerStyle">&nbsp;</td></tr>
                                <tr>
                                    <td>
                                        <table width="100%" cellspacing="0" cellpadding="0" border="0" bgcolor="#ffffff" style="@PanelTableStyle">
                                            <tbody>
                                                <tr>
                                                    <td style="@WarningsSectionContentStyle">
                                                        <div style="@WarningsHeadingStyle">Warnings (@warnings.Count)</div>
                                                        <div style="@SectionCaptionStyle">The run completed, but these items should be reviewed.</div>
                                                        <IssuesTable Issues="warnings" HeaderBackground="#fffaeb" HeaderForeground="#92620a" />
                                                    </td>
                                                </tr>
                                            </tbody>
                                        </table>
                                    </td>
                                </tr>
                            }

                            @foreach (var table in Report.Tables)
                            {
                                <tr><td height="18" style="@SpacerStyle">&nbsp;</td></tr>
                                <tr>
                                    <td>
                                        <table width="100%" cellspacing="0" cellpadding="0" border="0" bgcolor="#ffffff" style="@PanelTableStyle">
                                            <tbody>
                                                <tr>
                                                    <td style="@SectionContentStyle">
                                                        <div style="@TableHeadingStyle">@table.Title (@table.Rows.Count)</div>
                                                        <ResultTableView Table="table" />
                                                    </td>
                                                </tr>
                                            </tbody>
                                        </table>
                                    </td>
                                </tr>
                            }

                            <tr>
                                <td align="center" style="@FooterStyle">
                                    @FooterText &middot; @FormatDate(Report.GeneratedAtUtc)
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </td>
            </tr>
        </tbody>
    </table>
</body>
</html>

@code {
    [Parameter, EditorRequired]
    public RunReport Report { get; set; } = null!;

    [Parameter, EditorRequired]
    public RunReportingOptions Options { get; set; } = null!;

    private const string BodyStyle = "margin:0; padding:0; background-color:#f5f7fb; color:#101828; font-family:Segoe UI, Arial, sans-serif;";
    private const string PreheaderStyle = "display:none; font-size:1px; line-height:1px; color:#f5f7fb; max-height:0; max-width:0; mso-hide:all;";
    private const string FooterStyle = "padding:16px 8px 4px 8px; font-size:12px; line-height:17px; color:#98a2b3; mso-line-height-rule:exactly;";
    private const string OuterTableStyle = "width:100%; background-color:#f5f7fb; border-collapse:collapse; mso-table-lspace:0pt; mso-table-rspace:0pt;";
    private const string OuterCellStyle = "padding:28px 14px;";
    private const string ContainerTableStyle = "width:1180px; border-collapse:collapse; mso-table-lspace:0pt; mso-table-rspace:0pt;";
    private const string PanelTableStyle = "width:100%; background-color:#ffffff; border:1px solid #d7dde8; border-collapse:collapse; mso-table-lspace:0pt; mso-table-rspace:0pt;";
    private const string SummaryTableStyle = "width:100%; background-color:#f5f7fb; border-collapse:collapse; mso-table-lspace:0pt; mso-table-rspace:0pt;";
    private const string HeaderAccentStyle = "height:3px; font-size:1px; line-height:3px; mso-line-height-rule:exactly;";
    private const string HeaderContentStyle = "padding:21px 28px 23px 28px; background-color:#182b49;";
    private const string EyebrowStyle = "font-size:11px; line-height:15px; color:#adc4e2; font-weight:700; letter-spacing:1px; mso-line-height-rule:exactly;";
    private const string TitleStyle = "padding-top:6px; font-size:22px; line-height:28px; color:#ffffff; font-weight:700; mso-line-height-rule:exactly;";
    private const string StatusTableStyle = "margin-top:14px; border-collapse:collapse; mso-table-lspace:0pt; mso-table-rspace:0pt;";
    private const string SpacerStyle = "font-size:1px; line-height:1px; mso-line-height-rule:exactly;";
    private const string SummaryCellStyle = "padding:8px; vertical-align:top;";
    private const string SummaryCardStyle = "width:100%; background-color:#fbfcfe; border:1px solid #e6ebf2; border-collapse:collapse; mso-table-lspace:0pt; mso-table-rspace:0pt;";
    private const string SummaryCardCellStyle = "padding:10px 12px; vertical-align:top;";
    private const string SummaryLabelStyle = "font-size:10px; line-height:14px; color:#667085; font-weight:700; letter-spacing:0.5px; mso-line-height-rule:exactly;";
    private const string SummaryValueStyle = "padding-top:4px; font-size:14px; line-height:19px; color:#101828; mso-line-height-rule:exactly;";
    private const string SummaryCodeValueStyle = SummaryValueStyle + " font-family:Consolas, 'Courier New', monospace; font-size:13px; word-wrap:break-word;";
    private const string SectionContentStyle = "padding:18px 20px; background-color:#ffffff; border-left:4px solid #2557a7;";
    private const string ErrorsSectionContentStyle = "padding:18px 20px; background-color:#fffafa; border-left:4px solid #d92d20;";
    private const string WarningsSectionContentStyle = "padding:18px 20px; background-color:#fffdf7; border-left:4px solid #f79009;";
    private const string ErrorsHeadingStyle = "font-size:19px; line-height:26px; color:#b42318; font-weight:700; mso-line-height-rule:exactly;";
    private const string WarningsHeadingStyle = "font-size:19px; line-height:26px; color:#92620a; font-weight:700; mso-line-height-rule:exactly;";
    private const string TableHeadingStyle = "font-size:18px; line-height:25px; color:#1f3a5f; font-weight:700; mso-line-height-rule:exactly;";
    private const string SectionCaptionStyle = "padding-top:4px; padding-bottom:14px; font-size:13px; line-height:18px; color:#667085; mso-line-height-rule:exactly;";
    private const string AllClearContentStyle = "padding:14px 18px; background-color:#f8fffb; border-left:4px solid #12b76a;";
    private const string AllClearHeadingStyle = "font-size:17px; line-height:23px; color:#067647; font-weight:700; mso-line-height-rule:exactly;";
    private const string AllClearCaptionStyle = "padding-top:2px; font-size:13px; line-height:18px; color:#175d3b; mso-line-height-rule:exactly;";

    private static string SummaryValueStyleFor(bool isCopyFriendly) =>
        isCopyFriendly ? SummaryCodeValueStyle : SummaryValueStyle;

    private static bool IsRunIdAttribute(string name)
    {
        var normalized = name.Replace(" ", "", StringComparison.Ordinal)
            .Replace("_", "", StringComparison.Ordinal)
            .Replace("-", "", StringComparison.Ordinal);
        return string.Equals(normalized, "runid", StringComparison.OrdinalIgnoreCase);
    }

    private string FooterText => string.IsNullOrWhiteSpace(Options.ServiceName)
        ? "Generated by run reporting"
        : $"Generated by {Options.ServiceName} run reporting";

    private string StatusHeading => Report.Outcome switch
    {
        RunOutcome.Failed => "Run failed",
        RunOutcome.CompletedWithWarnings => $"Run completed with {Report.WarningCount} warnings",
        _ => "Run completed successfully"
    };

    private string OutcomeText => Report.Outcome switch
    {
        RunOutcome.Failed => "Failed",
        RunOutcome.CompletedWithWarnings => "Warnings",
        _ => "Succeeded"
    };

    private string StatusPillStyle =>
        $"padding:6px 13px; font-size:13px; line-height:17px; font-weight:700; letter-spacing:0.3px; color:{StatusForeground}; background-color:{StatusBackground}; border:1px solid {StatusBorder}; mso-line-height-rule:exactly;";

    private string StatusForeground => Report.Outcome switch
    {
        RunOutcome.Failed => "#7a271a",
        RunOutcome.CompletedWithWarnings => "#7a4d00",
        _ => "#067647"
    };

    private string StatusBackground => Report.Outcome switch
    {
        RunOutcome.Failed => "#fee4e2",
        RunOutcome.CompletedWithWarnings => "#fdf0cc",
        _ => "#d1fadf"
    };

    private string StatusBorder => Report.Outcome switch
    {
        RunOutcome.Failed => "#b42318",
        RunOutcome.CompletedWithWarnings => "#f79009",
        _ => "#12b76a"
    };

    private string AccentColor => Report.Outcome switch
    {
        RunOutcome.Failed => "#d92d20",
        RunOutcome.CompletedWithWarnings => "#f79009",
        _ => "#12b76a"
    };

    private static string FormatDate(DateTimeOffset value) => value.ToString("yyyy-MM-dd HH:mm:ss zzz", CultureInfo.InvariantCulture);
}
