@* Compact variant for clients that mangle rich HTML, e.g. Teams channel email addresses:
   outcome, counts, top issues, and table row counts — no nested layout tables. *@
@namespace RunReporting.Templates
@inherits RunReporting.RunReportTemplateBase

<div style="font-family:Segoe UI, Arial, sans-serif; font-size:14px; color:#101828;">
    <p style="margin:0 0 6px 0;">
        <strong>@Heading</strong><br />
        @Report.ErrorCount errors, @Report.WarningCount warnings
    </p>

    @if (AttributesLine.Length > 0)
    {
        <p style="margin:0 0 10px 0; font-size:13px; color:#475467;">@AttributesLine</p>
    }

    @if (TopIssues.Count > 0)
    {
        <ul style="margin:0 0 10px 18px; padding:0;">
            @foreach (var issue in TopIssues)
            {
                <li style="margin:0 0 4px 0;">@IssueLabel(issue): @issue.Message</li>
            }
        </ul>

        @if (Report.Issues.Count > MaxIssues)
        {
            <p style="margin:0 0 10px 0; font-size:13px; color:#475467;">&hellip;and @(Report.Issues.Count - MaxIssues) more issues in the full report.</p>
        }
    }

    @foreach (var table in Report.Tables)
    {
        <p style="margin:0 0 2px 0; font-size:13px; color:#475467;">@table.Title (@table.Rows.Count)</p>
    }
</div>

@code {
    private const int MaxIssues = 10;

    private IReadOnlyList<RunIssue> TopIssues => Report.Issues.Take(MaxIssues).ToList();

    private string Heading => string.IsNullOrWhiteSpace(Options.ServiceName)
        ? OutcomeText
        : $"{Options.ServiceName} — {OutcomeText}";

    private string OutcomeText => Report.Outcome switch
    {
        RunOutcome.Failed => "Run failed",
        RunOutcome.CompletedWithWarnings => $"Run completed with {Report.WarningCount} warnings",
        _ => "Run succeeded"
    };

    private string AttributesLine =>
        string.Join(" · ", Report.Attributes.Select(attribute => $"{attribute.Key}: {attribute.Value}"));

    private static string StepName(RunIssue issue) =>
        string.IsNullOrWhiteSpace(issue.StepName) ? "General" : issue.StepName;

    private static string IssueLabel(RunIssue issue) =>
        string.IsNullOrWhiteSpace(issue.IdentifierValue)
            ? StepName(issue)
            : $"{StepName(issue)} / {issue.IdentifierName}={issue.IdentifierValue}";
}
